+        recordPrecuMedicalForage(
+            self,
+            fixture,
+            "chance",
+            chance);
+        recordPrecuMedicalForage(
+            self,
+            fixture,
+            "successRoll",
+            successRoll);
+        if (successRoll > chance)
+        {
+            sendSystemMessage(
+                self,
+                new string_id("skl_use", "sys_forage_fail"));
