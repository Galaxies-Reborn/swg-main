+                    BEFORE_MIND,
+                    mind) +
+            " chargeDelta=" +
+                reverseDelta(
+                    player,
+                    BEFORE_CHARGES,
+                    charges) +
+            " medicalXpDelta=" +
+                delta(
+                    player,
+                    BEFORE_XP,
+                    medicalXp) +
+            " expectedMedicalXp=" +
+                Math.max(
+                    0,
+                    (int)(delta(
+                        player,
+                        BEFORE_BUFF,
+                        buff) * 2.5f)) +
