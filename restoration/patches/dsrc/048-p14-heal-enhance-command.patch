+    {
+        obj_id medicine =
+            getObjIdObjVar(player, ITEM);
+        obj_id patient =
+            getObjIdObjVar(player, PATIENT);
+        setObjVar(
+            player,
+            BEFORE_MIND,
+            getAttrib(player, MIND));
+        setObjVar(
+            player,
+            BEFORE_CHARGES,
