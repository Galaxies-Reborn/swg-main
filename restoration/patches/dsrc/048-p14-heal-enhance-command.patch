+        setObjVar(
+            medicine,
+            consumable.VAR_CONSUMABLE_STOMACH_VALUES,
+            new int[] { 0, 0, 0 });
+        setObjVar(
+            medicine,
+            consumable.VAR_SKILL_MOD_REQUIRED,
