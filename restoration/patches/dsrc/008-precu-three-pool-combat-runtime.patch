+        if (weaponCosts == null)
+        {
+            return invalid;
+        }
+        int[] costs = new int[3];
+        // SWGSource currently persists only six attributes and has no authoritative
+        // Strength, Quickness, or Focus values. Use the authentic neutral baseline
+        // until the nine-attribute persistence/network slice supplies those stats.
+        costs[0] = calculatePrecuHamCost(PRECU_NEUTRAL_GOVERNING_ATTRIBUTE, weaponCosts.getInt("healthCost"), healthMultiplier);
+        costs[1] = calculatePrecuHamCost(PRECU_NEUTRAL_GOVERNING_ATTRIBUTE, weaponCosts.getInt("actionCost"), actionMultiplier);
+        costs[2] = calculatePrecuHamCost(PRECU_NEUTRAL_GOVERNING_ATTRIBUTE, weaponCosts.getInt("mindCost"), mindMultiplier);
+        return costs;
