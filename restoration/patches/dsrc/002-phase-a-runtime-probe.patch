+    private boolean contains(String[] values, String expected)
+    {
+        if (values == null || expected == null)
+        {
+            return false;
+        }
+        for (String value : values)
+        {
+            if (expected.equals(value))
+            {
+                return true;
+            }
+        }
+        return false;
+    }
