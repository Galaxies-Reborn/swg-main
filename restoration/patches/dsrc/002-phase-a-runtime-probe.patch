+                return "error=operationDispatchStateFailed " + buildOperationStatus(player);
+            }
+            boolean queued = transferBankCreditsFromNamedAccount(
+                money.ACCT_CUSTOMER_SERVICE,
+                player,
+                CRAFTING_TRAINER_COST,
+                money.HANDLER_BANK_SUCCESS,
+                money.HANDLER_BANK_TRANSFER_ERROR,
