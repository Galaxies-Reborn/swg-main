+        return isIdValid(self) && exists(self) && !isDead(self) && !isIncapacitated(self) &&
+            !ai_lib.isAiDead(target) && !ai_lib.isInCombat(self) && !ai_lib.isInCombat(target) &&
+            getDistance(self, target) <= TAME_RANGE && !pet_lib.hasMaster(target) &&
