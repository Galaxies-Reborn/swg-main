+        }
+        if (pet_lib.hasMaxStoredPetsOfType(self, petType))
+        {
+            if (sendFailure)
+            {
+                sendSystemMessage(self, pet_lib.SID_SYS_TOO_MANY_STORED_PETS);
+            }
+            return false;
+        }
+        if (!pet_lib.canControlPetsOfLevel(
