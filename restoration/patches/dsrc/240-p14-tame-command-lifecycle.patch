+                sendSystemMessage(self, pet_lib.SID_SYS_CANT_TAME);
+            }
+            return false;
+        }
+        if (!hasSkill(self, "outdoors_creaturehandler_novice") ||
+            pet_lib.getChanceToTame(target, self) <= 0)
