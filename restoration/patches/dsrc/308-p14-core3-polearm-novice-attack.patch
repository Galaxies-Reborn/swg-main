+        {
+            obj_id inventory = getObjectInSlot(attacker, "inventory");
+            if (!isIdValid(inventory) || !putInOverloaded(current, inventory))
+            {
+                return "error=unexpectedAttackerWeapon " +
+                    buildStatus(attacker, defender, lifecycle);
