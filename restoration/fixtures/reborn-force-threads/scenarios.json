      "description": "Distinct stations and distinct causal domains seal only after a downstream outcome and reconcile to the origin.",
      "events": [
        { "schemaVersion": 1, "eventId": "valid-support", "at": 100, "type": "support", "from": "1001", "to": "2001", "domain": "PROVENANCE" },
        { "schemaVersion": 1, "eventId": "valid-relay", "at": 200, "type": "relay", "from": "2001", "to": "3001", "domain": "SHELTER" },
        { "schemaVersion": 1, "eventId": "valid-outcome", "at": 300, "type": "outcome", "actor": "3001", "domain": "OUTCOME" },
        { "schemaVersion": 1, "eventId": "valid-reconcile", "at": 400, "type": "reconcile", "station": "1001" }
      ],
      "expect": {
        "quarantined": false,
        "tokens": 0,
        "mailbox": 0,
        "ledger": 1,
        "sealedTotal": 1,
        "accepted": 4,
        "rejected": 0,
        "duplicates": 0,
        "sealed": 1,
        "reconciled": 1,
        "digest": "e33b480a6270dc76f7a92196e34d5959c37f156e2550717a5919717df2fc3515",
        "ledgerStations": { "1001": 1 },
        "sealedStations": { "1001": 1 }
      }
    },
